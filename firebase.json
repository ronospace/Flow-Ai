{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "flowai-production",
          "appId": "1:000000000000:android:0000000000000000000000",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "flowai-production",
          "appId": "1:000000000000:ios:0000000000000000000000",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "macos": {
        "default": {
          "projectId": "flowai-production",
          "appId": "1:000000000000:ios:0000000000000000000000",
          "uploadDebugSymbols": false,
          "fileOutput": "macos/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "flowai-production",
          "configurations": {
            "android": "1:000000000000:android:0000000000000000000000",
            "ios": "1:000000000000:ios:0000000000000000000000",
            "macos": "1:000000000000:ios:0000000000000000000000",
            "web": "1:000000000000:web:0000000000000000000000",
            "windows": "1:000000000000:web:0000000000000000000000"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
